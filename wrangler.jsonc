{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-ai-oncall-verifier",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // Chat UI: static files served straight from the edge; /api/* falls through to the Worker.
  "assets": { "directory": "./public", "binding": "ASSETS" },

  // LLM: Llama 3.3 70B on Workers AI.
  "ai": { "binding": "AI" },

  // Memory/state: one SQLite-backed Durable Object per incident.
  "durable_objects": {
    "bindings": [{ "name": "INCIDENT", "class_name": "IncidentRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["IncidentRoom"] }],

  // Coordination:
  //  - RECOVERY: long-running watch started on mitigation (durable sleeps + waitForEvent).
  //  - POSTMORTEM: durable, retryable multi-step postmortem generation.
  "workflows": [
    {
      "name": "recovery-watch-workflow",
      "binding": "RECOVERY",
      "class_name": "RecoveryWatchWorkflow"
    },
    {
      "name": "postmortem-workflow",
      "binding": "POSTMORTEM",
      "class_name": "PostmortemWorkflow"
    }
  ],

  // Time between recovery check-ins (any Workflows duration). A real on-call
  // rotation would use ~15 minutes; the public demo uses 2 so reviewers can
  // see a check-in without waiting.
  "vars": { "RECOVERY_CHECK_INTERVAL": "2 minutes" },

  // Per-IP abuse limits for the public deployment. AI_LIMITER guards the
  // endpoints that spend Workers AI quota; API_LIMITER guards all other writes.
  "ratelimits": [
    { "name": "AI_LIMITER", "namespace_id": "1001", "simple": { "limit": 12, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],

  "observability": { "enabled": true }
}
